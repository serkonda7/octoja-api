{
  "name": "octoja-api",
  "description": "TypeScript client for the Octoja API",
  "version": "0.1.1",
  "license": "UNLICENSED",
  "keywords": [
    "octoja",
    "rmm",
    "api",
    "client"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts -i ./openapi/1.1.1013.json -o ./src/generated",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "check": "tsc --noEmit",
    "coverage": "bun run scripts/check-coverage.ts",
    "docs": "bun run scripts/generate-docs.ts",
    "build": "tsc -p tsconfig.build.json && bun run scripts/build.ts",
    "prepack": "bun run generate && bun run build",
    "pack": "bun pm pack --filename octoja-api.tgz"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.5",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@hey-api/openapi-ts": "~0.0.0-next-20260930190945",
    "@types/bun": "~1.4.5",
    "typescript": "~7.0.2"
  }
}
